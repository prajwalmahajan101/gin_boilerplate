# gin_boilerplate — Environment Variables
# Copy to .env and fill in required values. .env is git-ignored.

# Server
PORT=8080
ENV=local

# Database (Postgres via pgx)
DATABASE_URL=postgres://gin_boilerplate:gin_boilerplate@localhost:5432/gin_boilerplate?sslmode=disable
DB_MAX_CONNS=0
DB_CONN_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=2000

# Valkey (Redis-compatible) — empty disables Valkey
VALKEY_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO
LOG_JSON=true
LOG_FILE=
LOG_MAX_MB=10
LOG_BACKUP_COUNT=5

# HTTP Edge
MAX_BODY_BYTES=1048576
CORS_ORIGINS=

# Auth
AUTH_TOKEN_SECRET=
JWT_ACCESS_TTL_M=15
JWT_REFRESH_TTL_H=168
API_KEY_HASH_PEPPER=

# Resilience
RETRY_MAX=3
RETRY_BASE_MS=200
BREAKER_FAIL_THRESHOLD=5
BREAKER_RECOVERY_S=30

# Rate Limit
RATE_LIMIT_RPM=120
LOGIN_RATE_LIMIT_RPM=10

# AWS Secrets Manager (optional — empty skips)
SECRETS_MANAGER_SECRET_ID=
